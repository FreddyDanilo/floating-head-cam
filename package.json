"scripts": {
  "format": "prettier --write .",
  "lint": "eslint --cache .",
  "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
  "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
  "typecheck": "npm run typecheck:node && npm run typecheck:web",
  "test": "vitest run",
  "test:watch": "vitest",
  "test:coverage": "vitest run --coverage",
  "start": "electron-vite preview",
  "dev": "electron-vite dev",
  "build": "npm run typecheck && electron-vite build",
  "postinstall": "electron-builder install-app-deps && patch-package && node scripts/sign-dev.mjs",
  "release:prepare": "node scripts/release-prepare.mjs",

  "build:win": "npm run release:prepare && npm run build && electron-builder --win --x64",
  "build:mac": "npm run release:prepare && npm run build && electron-builder --mac --arm64",
  "build:linux": "npm run release:prepare && npm run build && electron-builder --linux --x64",

  "release": "npm run release:prepare && npm run build && electron-builder -wlm --publish always",
  "release:win": "npm run release:prepare && npm run build && electron-builder --win --x64 --publish always",
  "release:mac": "npm run release:prepare && npm run build && electron-builder --mac --arm64 --publish always",
  "release:linux": "npm run release:prepare && npm run build && electron-builder --linux --publish always",

  "setup:make": "node scripts/setup-make.mjs"
}
